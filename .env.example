APP_ENV=development
DATABASE_URL=postgresql+asyncpg://virtujudge_ai:change-me@localhost:5432/virtujudge
REDIS_URL=redis://localhost:6379/0

BACKEND_INTERNAL_URL=http://localhost:8000/api/v1/internal
AI_WORKER_SHARED_SECRET=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=virtujudge
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me

AI_PROVIDER_MODE=fake
STT_MODEL=whisper-large-v3-turbo
DIARIZATION_MODEL=pyannote-community-1
# GroqCloud API key for fast dev-time transcription
GROQ_API_KEY=
# HuggingFace token for pyannote speaker diarization
HUGGINGFACE_TOKEN=
LLM_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
